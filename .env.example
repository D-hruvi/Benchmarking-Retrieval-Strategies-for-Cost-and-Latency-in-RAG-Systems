# (This project reads GROQ_API_KEY via os.environ -- if you use a .env file
# locally, load it yourself, e.g. with `python-dotenv` or by exporting it
# in your shell before running any script: export GROQ_API_KEY=...)

GROQ_API_KEY=your_groq_api_key_here
